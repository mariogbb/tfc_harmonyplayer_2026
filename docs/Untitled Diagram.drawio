        <mxCell id="F5Hebk4XFan7YIaqYws9-117" value="&lt;div style=&quot;color: rgb(171, 178, 191); background-color: rgb(40, 44, 52); font-family: &amp;quot;Droid Sans Mono&amp;quot;, &amp;quot;monospace&amp;quot;, monospace; font-weight: normal; font-size: 14px; line-height: 19px;&quot;&gt;&lt;div&gt;await&lt;span style=&quot;color: #abb2bf;&quot;&gt; db.&lt;/span&gt;&lt;span style=&quot;color: #61afef;&quot;&gt;execute&lt;/span&gt;&lt;span style=&quot;color: #abb2bf;&quot;&gt;(&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #abb2bf;&quot;&gt;            &lt;/span&gt;&lt;span style=&quot;color: #98c379;&quot;&gt;&quot;CREATE TABLE ALBUMS(ID INT UNSIGNED NOT NULL,URL TEXT NULL,PRIMARY KEY (ID))&quot;&lt;/span&gt;&lt;span style=&quot;color: #abb2bf;&quot;&gt;);&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #abb2bf;&quot;&gt;        &lt;/span&gt;&lt;span style=&quot;color: #5c6370;font-style: italic;&quot;&gt;// Artist table&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #abb2bf;&quot;&gt;        &lt;/span&gt;&lt;span style=&quot;color: #c678dd;&quot;&gt;await&lt;/span&gt;&lt;span style=&quot;color: #abb2bf;&quot;&gt; db.&lt;/span&gt;&lt;span style=&quot;color: #61afef;&quot;&gt;execute&lt;/span&gt;&lt;span style=&quot;color: #abb2bf;&quot;&gt;(&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #abb2bf;&quot;&gt;            &lt;/span&gt;&lt;span style=&quot;color: #98c379;&quot;&gt;&quot;CREATE TABLE ARTISTS(ID INT UNSIGNED NOT NULL,URL TEXT NULL,PRIMARY KEY (ID))&quot;&lt;/span&gt;&lt;span style=&quot;color: #abb2bf;&quot;&gt;);&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #abb2bf;&quot;&gt;        &lt;/span&gt;&lt;span style=&quot;color: #5c6370;font-style: italic;&quot;&gt;// Playlist table&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #abb2bf;&quot;&gt;        &lt;/span&gt;&lt;span style=&quot;color: #c678dd;&quot;&gt;await&lt;/span&gt;&lt;span style=&quot;color: #abb2bf;&quot;&gt; db.&lt;/span&gt;&lt;span style=&quot;color: #61afef;&quot;&gt;execute&lt;/span&gt;&lt;span style=&quot;color: #abb2bf;&quot;&gt;(&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #abb2bf;&quot;&gt;            &lt;/span&gt;&lt;span style=&quot;color: #98c379;&quot;&gt;&quot;CREATE TABLE PLAYLISTS(ID INTEGER PRIMARY KEY AUTOINCREMENT,PLAYLIST_NAME VARCHAR(50) NOT NULL)&quot;&lt;/span&gt;&lt;span style=&quot;color: #abb2bf;&quot;&gt;);&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #abb2bf;&quot;&gt;        &lt;/span&gt;&lt;span style=&quot;color: #c678dd;&quot;&gt;await&lt;/span&gt;&lt;span style=&quot;color: #abb2bf;&quot;&gt; db&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #abb2bf;&quot;&gt;            .&lt;/span&gt;&lt;span style=&quot;color: #61afef;&quot;&gt;execute&lt;/span&gt;&lt;span style=&quot;color: #abb2bf;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #98c379;&quot;&gt;&quot;CREATE UNIQUE INDEX AK_NAME ON PLAYLISTS(PLAYLIST_NAME)&quot;&lt;/span&gt;&lt;span style=&quot;color: #abb2bf;&quot;&gt;);&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #abb2bf;&quot;&gt;        &lt;/span&gt;&lt;span style=&quot;color: #5c6370;font-style: italic;&quot;&gt;// Songs table&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #abb2bf;&quot;&gt;        &lt;/span&gt;&lt;span style=&quot;color: #c678dd;&quot;&gt;await&lt;/span&gt;&lt;span style=&quot;color: #abb2bf;&quot;&gt; db.&lt;/span&gt;&lt;span style=&quot;color: #61afef;&quot;&gt;execute&lt;/span&gt;&lt;span style=&quot;color: #abb2bf;&quot;&gt;(&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #abb2bf;&quot;&gt;            &lt;/span&gt;&lt;span style=&quot;color: #98c379;&quot;&gt;&quot;CREATE TABLE SONGS(ID INT UNSIGNED, PLAYEDTIME INT UNSIGNED, PRIMARY KEY (ID))&quot;&lt;/span&gt;&lt;span style=&quot;color: #abb2bf;&quot;&gt;);&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #abb2bf;&quot;&gt;        &lt;/span&gt;&lt;span style=&quot;color: #5c6370;font-style: italic;&quot;&gt;// Playlist songs table&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #abb2bf;&quot;&gt;        &lt;/span&gt;&lt;span style=&quot;color: #c678dd;&quot;&gt;await&lt;/span&gt;&lt;span style=&quot;color: #abb2bf;&quot;&gt; db.&lt;/span&gt;&lt;span style=&quot;color: #61afef;&quot;&gt;execute&lt;/span&gt;&lt;span style=&quot;color: #abb2bf;&quot;&gt;(&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #abb2bf;&quot;&gt;            &lt;/span&gt;&lt;span style=&quot;color: #98c379;&quot;&gt;&quot;CREATE TABLE PLAYLIST_SONGS(SONG_ID INT UNSIGNED NOT NULL,PLAYLIST_ID INT UNSIGNED NOT NULL,FOREIGN KEY (PLAYLIST_ID) REFERENCES PLAYLISTS (ID) ON DELETE CASCADE ON UPDATE CASCADE,PRIMARY KEY (SONG_ID))&quot;&lt;/span&gt;&lt;span style=&quot;color: #abb2bf;&quot;&gt;);&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #abb2bf;&quot;&gt;        &lt;/span&gt;&lt;span style=&quot;color: #5c6370;font-style: italic;&quot;&gt;// Liked songs playlist&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #abb2bf;&quot;&gt;        &lt;/span&gt;&lt;span style=&quot;color: #c678dd;&quot;&gt;await&lt;/span&gt;&lt;span style=&quot;color: #abb2bf;&quot;&gt; db.&lt;/span&gt;&lt;span style=&quot;color: #61afef;&quot;&gt;insert&lt;/span&gt;&lt;span style=&quot;color: #abb2bf;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #98c379;&quot;&gt;&quot;PLAYLISTS&quot;&lt;/span&gt;&lt;span style=&quot;color: #abb2bf;&quot;&gt;, {&lt;/span&gt;&lt;span style=&quot;color: #98c379;&quot;&gt;&quot;PLAYLIST_NAME&quot;&lt;/span&gt;&lt;span style=&quot;color: #c678dd;&quot;&gt;:&lt;/span&gt;&lt;span style=&quot;color: #abb2bf;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #98c379;&quot;&gt;&quot;Liked songs&quot;&lt;/span&gt;&lt;span style=&quot;color: #abb2bf;&quot;&gt;});&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
